  "reproduce": "python tools/oracle.py --extract; python tools/context.py root:2203:0678 --asm --output build/workers/NAME/manager-context.json; decode instruction_packets with tools.disasm.iter_instructions(origin=-0x22030). Original flow edges and table/MZ fields are research facts, not acceptance.",
  "runtime_relocation_static_equation": {
    "DOS_entry_contract_inference": "For ordinary DOS MZ launch startup ES is PSP, so B is the DOS load-image paragraph. Actual launch or runtime trace has not been observed.",
    "apply_fact": "03f4 loads [0982];03f8 adds0010;03fe adds relocation record segment; if that add carries0401 skips write; otherwise ES=segment+base, DI=record offset,0407 adds same base to word ES:[DI].",
    "entry_fact": "0678 stores startup ES in CS:0982 before any call.",
    "equation": "B=(startup_ES+0x10) mod65536; if record_segment+B does not carry: memory[(record_segment+B):record_offset] += B mod65536",
    "fixed_0100_limit": "0x0100 is a reference-loader observation model, not an immediate constant in the original relocation loop."
  },
